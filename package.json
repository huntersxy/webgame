{
  "name": "webgame",
  "version": "3.1.0",
  "description": "汐兮雨的小鱼池 — 五子棋 & 围棋（神经网络）& 中国象棋 & 黑白棋（位棋盘 + 迭代加深 α-β + 终局精确求解）& 军棋",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-tfjs-wasm.mjs && node scripts/copy-ort-wasm.mjs && node scripts/copy-ruffle.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/copy-tfjs-wasm.mjs && node scripts/copy-ort-wasm.mjs && node scripts/copy-ruffle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "icons": "python scripts/generate-pwa-icons.py",
    "test": "node scripts/run-tests.mjs",
    "test:othello:smoke": "node scripts/othello-smoke.mjs",
    "test:tornado:smoke": "node scripts/tornado-smoke.mjs",
    "test:site": "node scripts/site-regression.mjs",
    "patch:tornado:swf": "node scripts/patch-tornado-swf.mjs",
    "check:tornado:swf": "node scripts/patch-tornado-swf.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@ruffle-rs/ruffle": "^0.6.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "onnxruntime-web": "^1.30.0"
  }
}
